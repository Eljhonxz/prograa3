
package arreglo67;
import java.util.Arrays;
public class Arreglo67 {
public static void main(String[] args) {

    int [] normal = {2,3,4,5};
    
    double suma = 0; 
    for(int i = 0 ; i< normal.length;i++ ){
    suma += normal[i];     
    }
    
    // Calculo media:
    double media = suma/normal.length;
    
    
    int [] mayor = new int [normal.length];
    int [] menor = new int [normal.length];
    
    int contarmay = 0;
    int contarmen = 0;
    
    
    for(int i = 0 ; i< normal.length;i++){
        if (normal[i]> media){
            mayor[contarmay] = normal[i];
            contarmay++;
        }
        
         if (normal[i]< media){
            menor[contarmen] = normal[i];
            contarmen++;
        }
        
    }
    
    // array
    int [] mayorexc = Arrays.copyOf( mayor , contarmay);    
    int [] menorexc = Arrays.copyOf( menor , contarmen);  
    
    System.out.println("Arreglo normal: " );
    for(int i = 0 ; i< normal.length;i++){
        System.out.println(normal[i]+ " " );
    }
    System.out.println("Media: " + media);
    
     System.out.print("Arreglo mayor[ " );
    for(int i = 0 ; i< mayorexc.length;i++){
        System.out.print(mayorexc[i]+ " " );
    }
    System.out.println("]");
    
         System.out.print("Arreglo menor[ " );
    for(int i = 0 ; i< menorexc.length;i++){
        System.out.print(menorexc[i]+ " " );
    }
    System.out.println("]");
    
    
    
    
    }
    
}
