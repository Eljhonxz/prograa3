
package mayorymenor;
import java.util.Scanner;


public class Mayorymenor {

public static void main(String[] args) {
Scanner teclado = new Scanner (System.in);


int PE [] = new int [30];

for (int i = 0; i<PE.length; i++){
    System.out.println("Ingrese los números " + (i+1) + ":");
    PE[i] = teclado.nextInt();
}

int mayor = PE[0];  //Esto se hace por si hay negativos
int menor = PE[0];  // Porque si fuera 0 seria incorrecto
// Como comienzo con PE[0] inicio con i=1
// Porque tecnicamente ya se esta analizando la posición 0
// Se pone despues de que el usuario haya digitado la PE[0]


for (int i = 1; i<PE.length; i++){
    if(PE[i]>mayor) {
        mayor = PE[i];
    } 
    if(PE[i]<menor){
        menor = PE[i];
    }
}

int conmayor = 0;
int conmenor = 0;

for (int i = 0; i<PE.length; i++){
    if (PE[i]== mayor){
conmayor++;        
    }
    
    if(PE[i]==menor){
        conmenor++;
    }
}

    System.out.println("Mayor:" + mayor + "\n" + "Repeticiones: " + conmayor);
    System.out.println("Menor: " + menor + "\n" + "Repeticiones: " + conmenor);
    
    }
    
}


