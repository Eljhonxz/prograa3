
package arreglo4;

public class Arreglo4 {

    public static void main(String[] args) {
        int [] j = {6,4,9,7,8,2};
        int tama = j.length;
        int [] h = new int [(tama+1)/2];
        
        for (int i = 0; i<tama/2; i++){
        h[i] = j[i] + j[tama-1-i];  // Tama - 1 - i es la ultima posición del arreglo
        }
        
        System.out.println("Arreglo h { ");
        for(int i = 0; i<h.length; i++){
            System.out.println(h[i] + " " );
        }
        System.out.println("}");
  
        
        

    }
    
}
