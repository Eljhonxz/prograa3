
package arreglo6;
import java.util.Scanner;
import java.util.Arrays;
public class Arreglo6 {
public static void main(String[] args) {
Scanner teclado = new Scanner (System.in);


int [] aaa = new int [7];   // arreglo
int [] bbb = new int [aaa.length];  // origen
int lost = 0;   // tamaño
int numperdido = 0;


System.out.println("Numero que quieres buscar: ");
numperdido = teclado.nextInt ();

for (int i = 0; i<aaa.length; i++){
    System.out.println("Escriba los numeros " + (i+1) + ";" );
    aaa[i] = teclado.nextInt ();
}

for (int i = 0; i<aaa.length; i++){
    if (aaa[i] == numperdido){
        bbb[lost] = (i+1);
        lost++;
        
    }
}

    System.out.println("Tu número buscado es: " + numperdido);
    
    
    System.out.println("Arreglo aaa: " );
for(int i = 0; i<aaa.length; i++){
    System.out.println("Posicion" + (i+1) + " : " + aaa[i]);
}    
    

int [] ubicaexact = Arrays.copyOf (bbb,lost);

    System.out.print("Ubicaciones del número [ ");
    for(int i = 0; i<ubicaexact.length; i++){
        System.out.print(ubicaexact[i] + " ");
    }
    System.out.println("]");

    
    

    }
    
}
