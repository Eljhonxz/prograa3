package tabma;

public class Tabma {

    public static void main(String[] args) {
int [][] tablama = new int [10][10]; // tabal 10*10

for (int i = 0; i<tablama.length; i++){
    for( int j = 0; j<tablama[i].length; j++){
    tablama[i][j] = (i + 1) * (j + 1);    
    }
}

for (int i = 0; i<tablama.length; i++){
//titulo para cada tabla porque sin ello se pierde mucho lo que se quiere mostrar
System.out.println("tabla del: " + (i+1));    

for (int j = 0; j<tablama[i].length; j++){
System.out.println((i+1) + "x" + (j+1) + " = " + tablama[i][j]);    
}

}

    }
    
}
