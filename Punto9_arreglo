
package arreglocaramelito;
public class Arreglocaramelito {
public static void main(String[] args) {

    int [] c = {7,2,3,4,5,6,7,7,9,20};  
  int entero = 7;
  int content = 0;
    
    for(int i = 0; i<c.length; i++){
    if (c[i] == entero){
        content++;
        
    }
        System.out.println("Posición "+ (i+1) + ": " + c[i]);    
    }
    System.out.println("El numero entero es: " + entero);
    System.out.println("El numero entero se repite este numero de veces: " + content);
    
    
    
    }
    
}
